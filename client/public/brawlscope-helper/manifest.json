{
  "manifest_version": 3,
  "name": "Brawl Híbrido — Recolha v101",
  "version": "101.0.0",
  "description": "Recolhe dados Ranked para o Brawl Híbrido e preenche a ferramenta de draft do PL Prodigy com o teu draft.",
  "permissions": [
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://brawlscope.com/*",
    "https://topbrawl.com/*",
    "https://powerleagueprodigy.com/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Abrir recolha Brawl Híbrido"
  },
  "content_scripts": [
    {
      "matches": [
        "https://powerleagueprodigy.com/plprodigy*"
      ],
      "js": [
        "pl-prodigy.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
